---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import { Icon } from 'astro-icon/components';
import Sidebar from '../components/Sidebar.astro';
import { defaultLocale, type Locale } from '../i18n';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const p = localizePath;

const seo = {
  title: t.rvos.seoTitle,
  description: t.rvos.seoDescription,
};
---

<Layout {seo} {locale}>
  <section class="page-hero">
    <Container>
      <div class="page-hero__content">
        <h1>{t.rvos.heroTitle}</h1>
        <p>{t.rvos.heroText}</p>
        <div class="hero-ctas">
          <Button href="https://github.com/FUMFGRP/mountaineerfi-remote-valley-os" customIcon>{t.common.viewGithub} <Fragment slot="icon"><Icon name="ic:baseline-launch"/></Fragment></Button>
          <Button href={p('/board', locale)} outlined>{t.common.exploreBoard}</Button>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <div class="content-with-sidebar">
      <div class="content-main">
        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.whatTitle}</h2>
          <p>{t.rvos.whatP1}</p>
          <p>{t.rvos.whatP2}</p>

          <div class="arch-diagram">
            <div class="arch-layer arch-layer--top">Dashboard &amp; Alerts <span class="arch-detail">Web UI + SMS + LoRa text messages</span></div>
            <div class="arch-arrow">↓</div>
            <div class="arch-layer arch-layer--mid">RV-OS Core API <span class="arch-detail">FastAPI / lightweight, offline-capable</span></div>
            <div class="arch-arrow">↓</div>
            <div class="arch-row">
              <div class="arch-layer arch-layer--bot">Sensor Ingestion <span class="arch-detail">MQTT + LoRa + serial bridges</span></div>
              <div class="arch-layer arch-layer--bot">Local LLM <span class="arch-detail">Offline AI assistant (Nepali + English)</span></div>
              <div class="arch-layer arch-layer--bot">GitHub Sync <span class="arch-detail">Async, when connected</span></div>
            </div>
            <div class="arch-arrow">↓</div>
            <div class="arch-layer arch-layer--data">Module Data Sources <span class="arch-detail">Waste · Water · Energy · Food · EV · Mesh</span></div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.sensorTitle}</h2>
          <p>Every module is instrumented with sensors that report operational data. A lightweight agent on each module cluster collects, timestamps, and stores data locally before relaying it over LoRa or MQTT to the central collector.</p>
          <div class="sensor-grid">
            <div class="sensor-item"><strong>Extruder temp</strong> <span>Serial / 5 sec / ~50B</span></div>
            <div class="sensor-item"><strong>Water turbidity / pH</strong> <span>Modbus / 15 min / ~120B</span></div>
            <div class="sensor-item"><strong>Solar voltage / current</strong> <span>Modbus / 10 sec / ~60B</span></div>
            <div class="sensor-item"><strong>Hydro turbine RPM</strong> <span>GPIO / 1 sec / ~16B</span></div>
            <div class="sensor-item"><strong>Battery SoC / temp</strong> <span>CAN bus / 30 sec / ~80B</span></div>
            <div class="sensor-item"><strong>Cold storage temp</strong> <span>I2C / 5 min / ~32B</span></div>
            <div class="sensor-item"><strong>EV charger status</strong> <span>MQTT/LoRa / event / ~100B</span></div>
            <div class="sensor-item"><strong>Mesh node uptime</strong> <span>LoRaWAN / 1 hr / ~24B</span></div>
          </div>
          <p style="margin-top: 1rem; font-size: var(--font-size-sm); opacity: 0.85;">Each module cluster has a local Raspberry Pi (or equivalent) running a lightweight agent. Agents communicate over LoRa when no Wi-Fi or satellite link is available.</p>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.llmTitle}</h2>
          <p>A small, locally-hosted language model runs on the hub server, powered by the micro-grid. It answers maintenance questions in Nepali and English, walks operators through troubleshooting, and translates documentation — all fully offline.</p>
          <div class="llm-specs">
            <div class="spec-item"><strong>Model:</strong> Quantized 7B (4-bit, ~4GB RAM)</div>
            <div class="spec-item"><strong>Hardware:</strong> Jetson Nano or equivalent (~15W)</div>
            <div class="spec-item"><strong>Capabilities:</strong> Troubleshooting, translation, education, field logging</div>
            <div class="spec-item"><strong>Updates:</strong> New weights delivered via USB or satellite sync</div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.offlineTitle}</h2>
          <p>Every component runs fully offline. Internet is never required for operation.</p>
          <div class="offline-table">
            <div class="offline-row"><span class="offline-label">Sensor ingestion</span><span class="offline-online">Stream normal</span><span class="offline-offline">Buffer locally indefinitely</span></div>
            <div class="offline-row"><span class="offline-label">Dashboard</span><span class="offline-online">Real-time data</span><span class="offline-offline">Cached data, update on reconnect</span></div>
            <div class="offline-row"><span class="offline-label">Local LLM</span><span class="offline-online">No change</span><span class="offline-offline">No change (always local)</span></div>
            <div class="offline-row"><span class="offline-label">GitHub sync</span><span class="offline-online">Push metrics, pull updates</span><span class="offline-offline">Queue for next connection</span></div>
            <div class="offline-row"><span class="offline-label">Alerting</span><span class="offline-online">SMS + dashboard</span><span class="offline-offline">LoRa + dashboard</span></div>
            <div class="offline-row"><span class="offline-label">OTA updates</span><span class="offline-online">Pull from GitHub</span><span class="offline-offline">USB stick update</span></div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.hardwareTitle}</h2>
          <div class="hw-table">
            <div class="hw-row"><span class="hw-part">Central server</span><span class="hw-spec">Raspberry Pi 4 (4GB)</span><span class="hw-power">~15W</span><span class="hw-cost">$75</span></div>
            <div class="hw-row"><span class="hw-part">Sensor agent (per module)</span><span class="hw-spec">Pi Zero 2 W</span><span class="hw-power">~3W</span><span class="hw-cost">$25</span></div>
            <div class="hw-row"><span class="hw-part">Local LLM node</span><span class="hw-spec">Jetson Nano</span><span class="hw-power">~15W</span><span class="hw-cost">$250</span></div>
            <div class="hw-row"><span class="hw-part">LoRa gateway</span><span class="hw-spec">Dragino LG-01</span><span class="hw-power">~2W</span><span class="hw-cost">$100</span></div>
            <div class="hw-row"><span class="hw-part">Local storage</span><span class="hw-spec">64GB SD + 256GB SSD</span><span class="hw-power">~2W</span><span class="hw-cost">$40</span></div>
            <div class="hw-row"><span class="hw-part">Networking</span><span class="hw-spec">Wi-Fi + LoRaWAN</span><span class="hw-power">~10W</span><span class="hw-cost">$80</span></div>
            <div class="hw-row hw-row--total"><span class="hw-part"><strong>Total per village</strong></span><span class="hw-spec"></span><span class="hw-power"><strong>~47W</strong></span><span class="hw-cost"><strong>~$570</strong></span></div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.securityTitle}</h2>
          <div class="security-grid">
            <div class="security-item"><Icon name="ic:baseline-lock" /> All data encrypted at rest</div>
            <div class="security-item"><Icon name="ic:baseline-phone-android" /> Sensor data locally owned — never transmitted without explicit sync</div>
            <div class="security-item"><Icon name="ic:baseline-analytics" /> GitHub sync sends aggregated metrics only unless configured otherwise</div>
            <div class="security-item"><Icon name="ic:baseline-construction" /> Physical access required to compromise sensor agents — no remote exploit path</div>
            <div class="security-item"><Icon name="ic:baseline-dashboard" /> Dashboard access controlled by local network + simple password (offline context)</div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.stackTitle}</h2>
          <div class="stack-grid">
            <div class="stack-item"><strong>API server</strong> FastAPI (Python)</div>
            <div class="stack-item"><strong>Dashboard</strong> Astro + SolidJS (static)</div>
            <div class="stack-item"><strong>Database</strong> SQLite (local), PostgreSQL (analytics)</div>
            <div class="stack-item"><strong>Sensor protocol</strong> MQTT over LoRa, Modbus RTU, CAN bus</div>
            <div class="stack-item"><strong>LLM inference</strong> llama.cpp (quantized 4-bit)</div>
            <div class="stack-item"><strong>Sync</strong> rsync over SSH (satellite)</div>
            <div class="stack-item"><strong>Containerization</strong> Docker Compose</div>
            <div class="stack-item"><strong>CI/CD</strong> GitHub Actions</div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.phasesTitle}</h2>
          <div class="phase-grid">
            <div class="phase-card">
              <span class="phase-badge">Phase 1</span>
              <h3>Single Village</h3>
              <p>One RV-OS instance serving all modules in one village. Setup: 2 days. Operator training: 1 week. Data stored locally, syncs when connected.</p>
            </div>
            <div class="phase-card">
              <span class="phase-badge">Phase 2</span>
              <h3>Valley-Wide</h3>
              <p>Multiple village instances connected via LoRa mesh backbone. Central dashboard at the hub village. Range: up to 50km corridor. Cross-village alerts.</p>
            </div>
            <div class="phase-card">
              <span class="phase-badge">Phase 3</span>
              <h3>Multi-Region</h3>
              <p>Independent deployments in different regions, each adapted to local conditions. Anonymous metrics feed back to the global project.</p>
            </div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.rvos.reposTitle}</h2>
          <div class="repo-grid">
            <div class="repo-card"><h3>rv-os-core</h3><p>API server, dashboard frontend, database schema</p></div>
            <div class="repo-card"><h3>rv-os-agent</h3><p>Per-module sensor agent firmware and scripts</p></div>
            <div class="repo-card"><h3>rv-os-local-llm</h3><p>Model quantization, prompt templates, deployment scripts</p></div>
            <div class="repo-card"><h3>rv-os-sync</h3><p>GitHub synchronization tooling</p></div>
            <div class="repo-card"><h3>rv-os-manifest</h3><p>Compatibility matrix of module versions</p></div>
            <div class="repo-card"><h3>rv-os-docs</h3><p>Central documentation, architecture, deployment guide</p></div>
          </div>
        </section>

        <CtaCardSection background="var(--theme-surface-2)" color="var(--theme-on-surface-2)">
          <h2>{t.rvos.ctaTitle}</h2>
          <p>{t.rvos.ctaText}</p>
          <div class="cta-row">
            <Button href="https://github.com/FUMFGRP/mountaineerfi-remote-valley-os" customIcon>{t.common.github} <Fragment slot="icon"><Icon name="ic:baseline-launch"/></Fragment></Button>
            <Button href={p('/jumla/apply', locale)} unelevated>{t.common.applyResidency}</Button>
            <Button href={p('/regions', locale)} outlined>{t.common.deployRegion}</Button>
          </div>
        </CtaCardSection>
      </div>
      <Sidebar context="rvos" {locale} />
    </div>
  </Container>
</Layout>

<style>
  .page-hero { margin: var(--section-margin) auto; }
  .page-hero__content { max-width: 40rem; }
  .hero-ctas { display: flex; gap: 1rem; margin-top: 1.5rem; }
  .content-with-sidebar { display: flex; gap: 3rem; align-items: flex-start; }
  .content-main { flex: 1; min-width: 0; }
  .arch-diagram { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 2rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); margin-top: 1.5rem; }
  .arch-layer { padding: 1rem 1.5rem; background-color: var(--accent-glacial-blue); color: var(--charcoal, #2D3436); border-radius: 0.75rem; font-weight: 600; text-align: center; min-width: 200px; }
  .arch-layer--top { background-color: var(--accent-sunset-orange); color: #fff; }
  .arch-layer--mid { background-color: var(--accent-deep-blue); color: #fff; }
  .arch-layer--bot { background-color: var(--charcoal, #2D3436); color: #fff; font-size: var(--font-size-xs); padding: 0.75rem 1rem; }
  .arch-layer--data { background-color: var(--theme-surface-2); color: var(--theme-on-surface-2); font-size: var(--font-size-sm); }
  .arch-detail { display: block; font-weight: 400; font-size: var(--font-size-xs); opacity: 0.8; margin-top: 0.25rem; }
  .arch-row { display: flex; gap: 0.5rem; }
  .arch-arrow { font-size: 1.5rem; color: var(--accent-sunset-orange); font-weight: 700; line-height: 1; }
  .sensor-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-top: 1rem; }
  .sensor-item { padding: 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.5rem; font-size: var(--font-size-xs); }
  .sensor-item strong { display: block; margin-bottom: 0.2rem; }
  .sensor-item span { opacity: 0.75; }
  .llm-specs { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1rem; }
  .spec-item { padding: 0.5rem 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.25rem; font-size: var(--font-size-sm); }
  .offline-table { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1rem; }
  .offline-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; padding: 0.5rem 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.25rem; font-size: var(--font-size-sm); }
  .offline-label { font-weight: 600; }
  .offline-online { color: var(--accent-deep-blue); }
  .offline-offline { color: var(--accent-sunset-orange); }
  .hw-table { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1rem; }
  .hw-row { display: grid; grid-template-columns: 2fr 2fr 1fr 1fr; gap: 0.5rem; padding: 0.5rem 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.25rem; font-size: var(--font-size-sm); }
  .hw-row--total { background-color: var(--accent-glacial-blue); color: var(--charcoal, #2D3436); }
  .hw-part { font-weight: 600; }
  .hw-spec { opacity: 0.85; }
  .hw-power, .hw-cost { text-align: right; }
  .security-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 1rem; }
  .security-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.5rem; font-size: var(--font-size-sm); }
  .stack-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 1rem; }
  .stack-item { padding: 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.5rem; font-size: var(--font-size-sm); }
  .stack-item strong { display: block; margin-bottom: 0.2rem; color: var(--accent-glacial-blue); }
  .phase-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .phase-card { padding: 1.5rem; border-radius: var(--theme-shape-radius); border: 2px solid var(--theme-surface-1); }
  .phase-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; background-color: var(--accent-glacial-blue); color: var(--charcoal, #2D3436); margin-bottom: 0.5rem; }
  .phase-card h3 { margin-bottom: 0.5rem; }
  .phase-card p { margin: 0; font-size: var(--font-size-sm); }
  .repo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .repo-card { padding: 1.25rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); }
  .repo-card h3 { font-family: var(--theme-font-family-sans); font-weight: 600; font-size: var(--font-size-sm); margin-bottom: 0.35rem; }
  .repo-card p { margin: 0; font-size: var(--font-size-xs); }
  .cta-row { display: flex; gap: 1rem; justify-content: center; }
  @media (max-width: 1024px) { .content-with-sidebar { flex-direction: column; } .sensor-grid { grid-template-columns: repeat(2, 1fr); } .repo-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .arch-row { flex-direction: column; } .sensor-grid, .security-grid, .stack-grid, .repo-grid { grid-template-columns: 1fr; } .phase-grid { grid-template-columns: 1fr; } .offline-row { grid-template-columns: 1fr; } .hw-row { grid-template-columns: 1fr; } .hero-ctas, .cta-row { flex-direction: column; align-items: center; } }
</style>
