---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import { Icon } from 'astro-icon/components';
import Sidebar from '../components/Sidebar.astro';

const seo = {
  title: 'Remote Valley OS — Open Source Blueprint | Architecture & GitHub | Mountaineer.fi',
  description: 'The full open-source system architecture behind Remote Valley OS. How 5 interconnected pillars work together. Fork on GitHub, contribute, deploy anywhere.',
};
---

<Layout {seo}>
  <section class="page-hero">
    <Container>
      <div class="page-hero__content">
        <h1>Remote Valley OS</h1>
        <p>The open-source system architecture. Five interconnected pillars designed as a unified framework for innovation in remote regions.</p>
      </div>
    </Container>
  </section>

  <Container>
    <div class="content-with-sidebar">
      <div class="content-main">
        <section style="margin: var(--section-margin) auto;">
          <h2>System Architecture</h2>
          <p>Remote Valley OS is not five separate projects — it's one integrated system. Each pillar feeds into and depends on the others:</p>
          <div class="architecture-list">
            <div class="arch-item">
              <span class="arch-label">Material Loop</span>
              <span class="arch-desc">Trash → Filament → 3D printed parts → Water filters, greenhouse fittings, EV components, mesh node enclosures</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Energy Loop</span>
              <span class="arch-desc">Solar → EV charging → EV batteries → Community microgrid → Mesh node power → Greenhouse lighting</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Data Loop</span>
              <span class="arch-desc">Mesh network → Sensor data (water, soil, weather) → Open database → Community dashboards → Decision support</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Food Loop</span>
              <span class="arch-desc">Greenhouse produce → Community nutrition → Seed saving → Indigenous biodiversity → Climate resilience</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Water Loop</span>
              <span class="arch-desc">Filtration → Clean drinking water → Reduced plastic bottle waste → Less trash → More filament feedstock</span>
            </div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>Open Source Philosophy</h2>
          <div class="philosophy-grid">
            <div class="phil-card">
              <h3>Designed for Adaptation</h3>
              <p>Every design includes documentation, bills of materials, and adaptation guides. A solution for Jumla should be adaptable to the Andes, the Arctic, or any remote region.</p>
            </div>
            <div class="phil-card">
              <h3>Appropriate Technology</h3>
              <p>We prioritize solutions that can be repaired locally using locally available tools and materials. No proprietary parts, no single-vendor dependencies.</p>
            </div>
            <div class="phil-card">
              <h3>Community Ownership</h3>
              <p>Communities own their infrastructure. We provide the blueprint, training, and support — but the mesh network, the water filters, the greenhouse belong to the people who use them.</p>
            </div>
            <div class="phil-card">
              <h3>Open License</h3>
              <p>All designs, code, and documentation are released under an open-source license (MIT / CERN OHL). Fork it, modify it, deploy it — no permission needed.</p>
            </div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>GitHub Repository</h2>
          <p>The full Remote Valley OS blueprint is organized into repositories:</p>
          <div class="repo-grid">
            <div class="repo-card">
              <h3>rvos-hardware</h3>
              <p>CAD files, schematics, and BOMs for all physical designs — filament extruder, water filter, greenhouse, EV charger, mesh node.</p>
            </div>
            <div class="repo-card">
              <h3>rvos-software</h3>
              <p>Firmware for mesh nodes, sensor monitoring dashboards, data collection tools, and community portal code.</p>
            </div>
            <div class="repo-card">
              <h3>rvos-docs</h3>
              <p>Complete documentation: deployment guides, training materials, case studies from Jumla, and adaptation frameworks.</p>
            </div>
            <div class="repo-card">
              <h3>rvos-board</h3>
              <p>Innovation Board — the 5-pillar framework, project tracking, contribution guidelines, and community discussions.</p>
            </div>
          </div>
          <div style="text-align: center; margin-top: 2rem;">
            <Button href="https://github.com/mountaineer-fi/remote-valley-os" customIcon>View on GitHub <Fragment slot="icon"><Icon name="ic:baseline-launch"/></Fragment></Button>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>Roadmap</h2>
          <div class="roadmap-grid">
            <div class="roadmap-item roadmap-item--done">
              <span class="roadmap-badge">Done</span>
              <h3>Jumla Reconnaissance</h3>
              <p>Initial field research, community relationships established, baseline data collected across all 5 pillars.</p>
            </div>
            <div class="roadmap-item roadmap-item--current">
              <span class="roadmap-badge">Current</span>
              <h3>Prototype Phase</h3>
              <p>Building and testing first prototypes in Jumla. Filament extruder, ceramic water filter, greenhouse pilot, mesh node v1.</p>
            </div>
            <div class="roadmap-item">
              <span class="roadmap-badge">Next</span>
              <h3>Open Source Release</h3>
              <p>Publish all designs, documentation, and code on GitHub. Launch contribution framework and residency applications.</p>
            </div>
            <div class="roadmap-item">
              <span class="roadmap-badge">Future</span>
              <h3>Global Adaptation</h3>
              <p>Pilot programs in other remote regions. Adaptation guides for Andes, Arctic, and other isolated communities worldwide.</p>
            </div>
          </div>
        </section>

        <CtaCardSection background="var(--theme-surface-2)" color="var(--theme-on-surface-2)">
          <h2>Get Involved</h2>
          <p>Star the repo, open an issue, submit a PR, or apply for the Jumla residency. Every contribution moves the mission forward.</p>
          <div class="cta-row">
            <Button href="https://github.com/mountaineer-fi/remote-valley-os" customIcon>GitHub <Fragment slot="icon"><Icon name="ic:baseline-launch"/></Fragment></Button>
            <Button href="/jumla/apply" unelevated>Apply for Residency</Button>
          </div>
        </CtaCardSection>
      </div>
      <Sidebar context="rvos" />
    </div>
  </Container>
</Layout>

<style>
  .page-hero { margin: var(--section-margin) auto; }
  .page-hero__content { max-width: 40rem; }
  .architecture-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .arch-item { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem; padding: 1rem; background-color: var(--theme-surface-1); border-radius: 0.5rem; font-size: var(--font-size-sm); }
  .arch-label { font-weight: 600; color: var(--accent-sunset-orange); }
  .philosophy-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .phil-card { padding: 1.5rem; border-radius: var(--theme-shape-radius); border: 1px solid var(--theme-surface-1); }
  .phil-card h3 { margin-bottom: 0.5rem; }
  .phil-card p { margin: 0; font-size: var(--font-size-sm); }
  .repo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .repo-card { padding: 1.5rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); }
  .repo-card h3 { font-family: var(--theme-font-family-sans); font-weight: 600; font-size: var(--font-size-base); margin-bottom: 0.5rem; }
  .repo-card p { margin: 0; font-size: var(--font-size-sm); }
  .roadmap-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .roadmap-item { padding: 1.5rem; border-radius: var(--theme-shape-radius); border: 2px solid var(--theme-surface-1); }
  .roadmap-item--done { border-color: var(--accent-glacial-blue); }
  .roadmap-item--current { border-color: var(--accent-sunset-orange); }
  .roadmap-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; background-color: var(--theme-surface-1); margin-bottom: 0.5rem; }
  .roadmap-item--done .roadmap-badge { background-color: var(--accent-glacial-blue); color: #fff; }
  .roadmap-item--current .roadmap-badge { background-color: var(--accent-sunset-orange); color: #fff; }
  .roadmap-item h3 { margin-bottom: 0.5rem; font-size: var(--font-size-md); }
  .roadmap-item p { margin: 0; font-size: var(--font-size-sm); }
  .cta-row { display: flex; gap: 1rem; justify-content: center; }
  .content-with-sidebar { display: flex; gap: 3rem; align-items: flex-start; }
  .content-main { flex: 1; min-width: 0; }
  @media (max-width: 1024px) { .content-with-sidebar { flex-direction: column; } }
  @media (max-width: 768px) { .arch-item { grid-template-columns: 1fr; } .philosophy-grid, .repo-grid, .roadmap-grid { grid-template-columns: 1fr; } .cta-row { flex-direction: column; align-items: center; } }
</style>
