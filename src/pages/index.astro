---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import { Icon } from 'astro-icon/components';

const seo = {
  title: 'Remote Valley OS — Open Innovation for the World\'s Toughest Environment | Mountaineer.fi',
  description: 'An open-source blueprint for innovation in remote regions. 5 pillars: trash-to-filament, water purification, food production, EV logistics, mesh networks. Field-tested in Jumla, Nepal.',
};

const pillars = [
  { title: 'Trash → 3D Filament', desc: 'Turning Himalayan plastic waste into recycled 3D printing filament for remote manufacturing.', slug: '/board#filament' },
  { title: 'Water Purification', desc: 'Low-cost, low-maintenance filtration for glacial melt and contaminated high-altitude sources.', slug: '/board#water' },
  { title: 'Food Production', desc: 'High-altitude greenhouses, indigenous seed banks, and hydroponic systems for remote communities.', slug: '/board#food' },
  { title: 'EV Logistics Network', desc: 'Electric vehicle charging stations every 50km, creating a sustainable Himalayan transport corridor.', slug: '/board#ev' },
  { title: 'Mesh Communication', desc: 'Decentralized peer-to-peer mesh network — no towers, no cellular, just resilient connectivity.', slug: '/board#mesh' },
];
---

<Layout {seo}>
  <section class="home-hero">
    <Container>
      <div class="home-hero__grid">
        <div class="home-hero__text">
          <p class="home-hero__label">Remote Valley OS</p>
          <h1>Open Innovation for the World's Toughest Environment</h1>
          <p>An open-source blueprint for innovation in remote regions. Born from years spent in the Himalayas tackling real problems — plastic waste, contaminated water, food insecurity, isolation, and lack of connectivity.</p>
          <div class="home-hero__btns">
            <Button href="/board" customIcon>Explore the Board <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
            <Button href="/jumla" unelevated>Jumla Residency</Button>
            <Button href="/regions" outlined>Deploy in Your Region</Button>
          </div>
        </div>
        <div class="home-hero__image">
          <img src="/assets/images/home/classic-hero.jpg" alt="Himalayan landscape" />
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <h2 style="text-align: center;">The 5 Pillars</h2>
      <p style="text-align: center; max-width: 40rem; margin: 0 auto 2rem;">Every pillar is designed, prototyped, and field-tested in real remote conditions. All designs are open source on GitHub.</p>
      <div class="pillars-grid">
        {pillars.map(p => (
          <a href={p.slug} class="pillar-card">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="pillar-cta">Learn more →</span>
          </a>
        ))}
      </div>
    </section>
  </Container>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <div class="feature-cards">
        <a href="/board" class="feature-card">
          <h3>Innovation Board</h3>
          <p>The complete framework — 5 pillars with implementation guides, schematics, bill of materials, and deployment playbooks.</p>
          <span class="pillar-cta">View Board →</span>
        </a>
        <a href="/jumla" class="feature-card">
          <h3>Jumla Field Study</h3>
          <p>Our living laboratory in one of Nepal's most remote districts. Apply for a residency to prototype solutions in the toughest conditions on earth.</p>
          <span class="pillar-cta">Apply for Residency →</span>
        </a>
        <a href="/remote-valley-os" class="feature-card">
          <h3>Open Source Blueprint</h3>
          <p>The full system architecture, open-source code, and contribution guides. Fork it, adapt it, deploy it anywhere.</p>
          <span class="pillar-cta">View on GitHub →</span>
        </a>
        <a href="/regions" class="feature-card">
          <h3>Deploy in Your Region</h3>
          <p>A six-step blueprint for adapting RVOS to any remote community. Fork the repos, form a team, start building.</p>
          <span class="pillar-cta">Get the Blueprint →</span>
        </a>
      </div>
    </section>
  </Container>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-number">5</span>
          <span class="stat-label">Active Pillars</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">∞</span>
          <span class="stat-label">Open Source</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">1</span>
          <span class="stat-label">Field Lab (Jumla)</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">150K+</span>
          <span class="stat-label">YouTube Community</span>
        </div>
      </div>
    </section>
  </Container>

  <CtaCardSection background="var(--theme-surface-2)" color="var(--theme-on-surface-2)">
    <h2>Built for the Toughest Place on Earth</h2>
    <p>If it works in Jumla, it works anywhere. Explore the board, apply for a residency, or contribute on GitHub.</p>
    <div class="cta-row">
      <Button href="/board" customIcon>Explore the Board <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
      <Button href="/jumla" unelevated>Jumla Residency</Button>
      <Button href="/regions" outlined>Deploy in Your Region</Button>
    </div>
  </CtaCardSection>
</Layout>

<style>
  .home-hero { margin: var(--section-margin) auto; }
  .home-hero__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; min-height: 70vh; }
  .home-hero__label { text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--font-size-sm); color: var(--accent-glacial-blue); font-weight: 600; margin-bottom: 0.5rem; }
  .home-hero__text { max-width: 28rem; }
  .home-hero__btns { display: flex; gap: 1rem; margin-top: 1.5rem; }
  .home-hero__image img { width: 100%; height: 70vh; object-fit: cover; border-radius: var(--theme-shape-radius); }
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .pillar-card { display: block; padding: 1.5rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); text-decoration: none; color: inherit; transition: transform 0.2s; }
  .pillar-card:hover { transform: translateY(-3px); }
  .pillar-card h3 { margin-bottom: 0.5rem; }
  .pillar-card p { margin: 0; font-size: var(--font-size-sm); opacity: 0.85; }
  .pillar-cta { display: inline-block; margin-top: 0.75rem; font-weight: 600; font-size: var(--font-size-sm); color: var(--accent-deep-blue); }
  .feature-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .feature-card { padding: 2rem; border-radius: var(--theme-shape-radius); border: 2px solid var(--theme-surface-1); text-decoration: none; color: inherit; transition: border-color 0.2s; display: flex; flex-direction: column; }
  .feature-card:hover { border-color: var(--accent-deep-blue); }
  .feature-card p { margin: 0.5rem 0; font-size: var(--font-size-sm); opacity: 0.85; flex: 1; }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; text-align: center; }
  .stat-item { display: flex; flex-direction: column; align-items: center; }
  .stat-number { font-family: var(--theme-font-family-display); font-size: var(--font-size-xxl); color: var(--accent-sunset-orange); }
  .stat-label { font-size: var(--font-size-sm); opacity: 0.8; }
  .cta-row { display: flex; gap: 1rem; justify-content: center; }
  @media (max-width: 768px) { .home-hero__grid { grid-template-columns: 1fr; } .home-hero__image img { height: 40vh; } .pillars-grid, .feature-cards, .stats-row { grid-template-columns: 1fr; } .cta-row { flex-direction: column; align-items: center; } .home-hero__btns { flex-direction: column; } }
</style>

