---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About Remote Valley OS | Open-Source Blueprint for Remote Regions',
	description: 'Remote Valley OS is an open-source operating system and blueprint for innovation in remote regions — built on 5 interconnected pillars, field-tested in Jumla, Nepal.',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>About Remote Valley OS</h1>
			<p>
				An open-source operating system for the world's toughest environments. Five interconnected pillars, field-tested in the Himalayas, built for any remote region on earth.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/classic-hero.jpg"
        alt="Himalayan mountain landscape"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>
  <TextSection narrow>
    <h2>What Is Remote Valley OS?</h2>
    <p>
      Remote Valley OS is an open-source operating system and innovation framework for remote communities. It is not software — it is a blueprint for solving systemic challenges in isolated regions: plastic waste, contaminated water, food insecurity, energy poverty, and lack of connectivity.
    </p>
    <p>
      Born from years of field research in Jumla, Nepal — one of the most remote districts on earth — Remote Valley OS provides actionable designs, schematics, bills of materials, and deployment guides for five interconnected pillars.
    </p>

    <h2>Innovation Board</h2>
    <p>
      The <a href="/board">Innovation Board</a> organizes the work into five pillars, each addressing a critical need:
    </p>
    <p>
      <strong>Trash → 3D Filament:</strong> Turning Himalayan plastic waste into recycled 3D printing filament for local manufacturing.
    </p>
    <p>
      <strong>Water Purification:</strong> Low-cost, low-maintenance filtration for glacial melt and contaminated high-altitude sources.
    </p>
    <p>
      <strong>Food Production:</strong> High-altitude greenhouses, indigenous seed banks, and hydroponic systems.
    </p>
    <p>
      <strong>EV Logistics Network:</strong> Electric vehicle charging stations every 50km for a sustainable transport corridor.
    </p>
    <p>
      <strong>Mesh Communication:</strong> Decentralized peer-to-peer mesh networks — no towers, no cellular, just resilient connectivity.
    </p>

    <h2>Open-Source Blueprint</h2>
    <p>
      Every design, every line of code, and every deployment guide is open source. Available on <a href="https://github.com/mountaineer-fi/remote-valley-os">GitHub</a> under MIT and CERN OHL licenses. Fork it, adapt it, deploy it anywhere — no permission needed.
    </p>
    <p>
      Remote Valley OS is a project of Mountaineer.fi and lives at <strong>remotevalley.mountaineer.fi</strong>.
    </p>
  </TextSection>
</Layout>
