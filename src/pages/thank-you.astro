---
import Layout from '../layouts/Page.astro';
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';

const seo = {
  title: 'Thank You | Remote Valley OS',
  description: 'Your message has been received. We will get back to you soon.',
};
---

<Layout {seo}>
  <Container>
    <section style="margin: var(--section-margin) auto; text-align: center; min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
      <h1>Thank You</h1>
      <p style="max-width: 28rem; margin-bottom: 2rem;">Your message has been received. We review every application and will get back to you within 5 business days.</p>
      <div class="cta-row">
        <Button href="/board" customIcon>Explore the Board <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
        <Button href="/" unelevated>Back to Home</Button>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .cta-row { display: flex; gap: 1rem; justify-content: center; }
  @media (max-width: 768px) { .cta-row { flex-direction: column; align-items: center; } }
</style>
