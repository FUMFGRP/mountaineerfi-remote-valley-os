---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { docsBasePath, getDocItems } from '../../../i18n/docs';
import { type Locale } from '../../../i18n';

// Localized doc pages — Nepali only, generated for translated docs.
// Untranslated docs link to the English original from the sidebar.
export async function getStaticPaths() {
  const ne = await getCollection('docsNe');
  return ne.map((entry) => ({
    params: { locale: 'ne', slug: entry.slug },
    props: { entry },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props;
const { Content } = await render(entry);
const items = await getDocItems('ne');
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  items={items}
  basePath={docsBasePath('ne')}
  currentSlug={entry.slug}
  locale={locale}
  translated={true}
>
  <Content />
</DocsLayout>
