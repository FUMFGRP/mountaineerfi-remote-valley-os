---
import { parse, isBefore } from 'date-fns';
import {
	Container,
	TextCardSection,
	BlogPostsList,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import Sidebar from '../../components/Sidebar.astro';

const posts = await Astro.glob('./posts/*.mdx').then(posts =>
	posts
		.map(({ frontmatter, url }) => ({
			title: frontmatter.title,
			description: frontmatter.description,
			authors: frontmatter.authors,
			publishDate: parse(frontmatter.publishDate, 'MMMM d, yyyy', new Date()),
			featuredImage: frontmatter.featuredImage,
			excerpt: frontmatter.excerpt,
			href: url,
		}))
		.sort((a, b) => {
			if (isBefore(a.publishDate, b.publishDate)) return 1;
			if (isBefore(b.publishDate, a.publishDate)) return -1;
			return 0;
		})
);

const seo = {
	title: 'Field Reports | Remote Valley OS',
	description: 'Field reports, technical guides, and stories from the Remote Valley OS project. Open-source innovation in the world\'s toughest environments.',
};
---

<Layout {seo}>
	<Container>
		<div class="content-with-sidebar">
			<div class="content-main">
				<TextCardSection>
					<h1>Field Reports</h1>
					<p>
						Stories from the field — Jumla updates, technical deep-dives, and community reports from the Remote Valley OS project.
					</p>
					<NewsletterForm />
				</TextCardSection>
				<section class="blog-posts-list__section">
					<h2>Recent Reports</h2>
					<BlogPostsList posts={posts} />
				</section>
			</div>
			<Sidebar context="blog" />
		</div>
	</Container>
</Layout>

<style>
	.blog-posts-list__section {
		margin: var(--section-margin) auto;
	}
	.content-with-sidebar { display: flex; gap: 3rem; align-items: flex-start; }
	.content-main { flex: 1; min-width: 0; }
	@media (max-width: 1024px) { .content-with-sidebar { flex-direction: column; } }
</style>
