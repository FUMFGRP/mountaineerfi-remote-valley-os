---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import { Icon } from 'astro-icon/components';
import Sidebar from '../../components/Sidebar.astro';
import { defaultLocale, type Locale } from '../../i18n';
import { localizePath, useTranslations } from '../../i18n/utils';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const p = localizePath;

const seo = {
  title: t.jumla.seoTitle,
  description: t.jumla.seoDescription,
};

const tracks = [
  { icon: 'ic:baseline-bolt', title: 'Renewable Energy Engineer', desc: 'Install the hybrid micro-grid — solar, hydro, wind, batteries. Set up distribution, load management, and monitoring.', dur: '6-12 mo' },
  { icon: 'ic:baseline-build', title: 'Mechanical Engineer / Maker', desc: 'Build the shredder and filament extruder line. Commission the 3D printer farm. Design jigs and tooling.', dur: '6-12 mo' },
  { icon: 'ic:baseline-print', title: '3D Printing Specialist', desc: 'Run the printer farm. Build the open-source parts library. Train local designers. Produce functional parts.', dur: '6-12 mo' },
  { icon: 'ic:baseline-restaurant', title: 'Food Scientist', desc: 'Set up the apple processing hub: cold storage, cider line, vinegar fermentation, dehydration.', dur: '6-12 mo' },
  { icon: 'ic:baseline-water-drop', title: 'Water & Sanitation Engineer', desc: 'Install purification nodes at charging stations. Set up the water quality testing lab.', dur: '3-6 mo' },
  { icon: 'ic:baseline-school', title: 'Curriculum Designer', desc: 'Turn technical knowledge into visual, multilingual training guides. Build the 4-level training pipeline.', dur: '6-12 mo' },
  { icon: 'ic:baseline-wifi', title: 'Mesh Network Engineer', desc: 'Deploy LoRa and Wi-Fi mesh nodes across the valley. Set up the local LLM server. Build sensor pipelines.', dur: '3-6 mo' },
  { icon: 'ic:baseline-home', title: 'Natural Building Lead', desc: 'Lead construction of natural homes using stone, timber, earth. Integrate 3D-printed connectors.', dur: '6-12 mo' },
];

const pilotFindings = [
  { stat: '~960kg/month', label: 'Plastic waste per village', color: 'var(--accent-sunset-orange)' },
  { stat: '50 tons/year', label: 'Apple production in village', color: 'var(--accent-deep-blue)' },
  { stat: '40%', label: 'Post-harvest loss without cold storage', color: 'var(--accent-sunset-orange)' },
  { stat: '3,000m', label: 'Elevation — thinner air, 20-30% more solar', color: 'var(--accent-glacial-blue)' },
];

const modules = [
  { title: 'Water Purification', finding: 'Feasibility: HIGH. Diarrheal disease is the #1 health complaint. Gravity-fed spring system exists — only filtration + UV needed at point of use.', priority: 'Highest impact, deploy first' },
  { title: 'Energy Micro-Grid', finding: 'Feasibility: MEDIUM-HIGH. Solar + hydro is the right combo. Stream provides 25 L/s at 15m head = 3.7kW theoretical. Winter solar drops 40-60%.', priority: 'Foundation for all other modules' },
  { title: 'Trash to Filament', finding: 'Feasibility: HIGH. Community members expressed embarrassment about plastic litter. Turning waste into valuable material is culturally resonant.', priority: 'Phase 2 deployment' },
  { title: 'Food Production', finding: 'Feasibility: HIGH. Highest economic impact potential. 50 tons apples/year, 90% sold raw at low prices. Cold storage + processing = 10x income.', priority: 'Phase 1 alongside water' },
  { title: 'Logistics EV', finding: 'Feasibility: LOW-MEDIUM. Defer full corridor. Deploy single e-cargo trike for farm-to-market transport as proof of concept.', priority: 'Phase 3 after road improvements' },
  { title: 'Mesh Communication', finding: 'Feasibility: HIGH. 2G only in village center. Valley shape needs 2-3 ridge-top repeaters. Health post telemedicine is main use case.', priority: 'Deploy alongside water' },
];
---

<Layout {seo} {locale}>
  <section class="page-hero">
    <Container>
      <div class="page-hero__content">
        <h1>{t.jumla.heroTitle}</h1>
        <p>{t.jumla.heroText}</p>
        <div class="hero-ctas">
          <Button href={p('/jumla/apply', locale)} customIcon>{t.common.applyResidency} <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
          <Button href="#findings" outlined>{t.common.readFindings}</Button>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <div class="content-with-sidebar">
      <div class="content-main">
        <section style="margin: var(--section-margin) auto;">
          <h2>{t.jumla.whyTitle}</h2>
          <div class="jumla-intro">
            <div class="jumla-intro__text">
              <p>{t.jumla.whyP1}</p>
              <p>{t.jumla.whyP2}</p>
              <p>{t.jumla.whyP3}</p>
            </div>
            <div class="jumla-intro__stats">
              {pilotFindings.map(f => (
                <div class="jumla-stat" style="border-left: 4px solid {f.color};">
                  <strong>{f.stat}</strong>
                  <span>{f.label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;" id="findings">
          <h2>{t.jumla.findingsTitle}</h2>
          <p style="max-width: 40rem;">{t.jumla.findingsText}</p>
          <div class="findings-grid">
            {modules.map(m => (
              <div class="finding-card">
                <div class="finding-header">
                  <h3>{m.title}</h3>
                  <span class="finding-priority">{m.priority}</span>
                </div>
                <p>{m.finding}</p>
              </div>
            ))}
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.jumla.residencyTitle}</h2>
          <p style="max-width: 40rem;">{t.jumla.residencyP1}</p>
          <p style="max-width: 40rem;">{t.jumla.residencyP2}</p>

          <div class="residency-tracks">
            {tracks.map(track => (
              <div class="track-card">
                <div class="track-icon"><Icon name={track.icon} /></div>
                <div class="track-info">
                  <h3>{track.title}</h3>
                  <p>{track.desc}</p>
                  <span class="track-duration">{track.dur}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.jumla.conditionsTitle}</h2>
          <div class="conditions-grid">
            <div class="condition-card">
              <h3><Icon name="ic:baseline-home" /> Housing</h3>
              <p>Private room in a natural home built from local stone and timber. Powered by the micro-grid. Shared kitchen and common area.</p>
            </div>
            <div class="condition-card">
              <h3><Icon name="ic:baseline-restaurant" /> Food</h3>
              <p>Monthly food stipend included. Communal produce from the region. Residents cook together or take meals with host families.</p>
            </div>
            <div class="condition-card">
              <h3><Icon name="ic:baseline-science" /> Workspace</h3>
              <p>Full access to the fabrication lab — 3D printers, hand tools, electronics bench — plus testing equipment and shared studio.</p>
            </div>
            <div class="condition-card">
              <h3><Icon name="ic:baseline-wifi" /> Connectivity</h3>
              <p>WiFi at the hub via mesh network. Starlink gateway provides internet. Reliable but not city-speed — plan accordingly.</p>
            </div>
            <div class="condition-card">
              <h3><Icon name="ic:baseline-ac-unit" /> Climate</h3>
              <p>Temperate Himalayan. Summer: mild, monsoon. Winter: cold, dry, clear. Pack for cold nights year-round at 2,300m.</p>
            </div>
            <div class="condition-card">
              <h3><Icon name="ic:baseline-airplanemode-active" /> Travel</h3>
              <p>Ground transport from Nepalgunj or Kathmandu to Jumla arranged. International travel is the resident's responsibility.</p>
            </div>
          </div>
        </section>

        <section style="margin: var(--section-margin) auto;">
          <h2>{t.jumla.termsTitle}</h2>
          <div class="terms-table">
            <div class="term-row"><span class="term-label">Duration</span><span class="term-value">Minimum 3 months. Preferred 6-12 months.</span></div>
            <div class="term-row"><span class="term-label">Housing</span><span class="term-value">Free (private or shared room)</span></div>
            <div class="term-row"><span class="term-label">Food stipend</span><span class="term-value">Monthly allowance included</span></div>
            <div class="term-row"><span class="term-label">Workspace</span><span class="term-value">Free access to fab lab and tools</span></div>
            <div class="term-row"><span class="term-label">Travel</span><span class="term-value">In-country ground transport arranged</span></div>
            <div class="term-row"><span class="term-label">Stipend</span><span class="term-value">Modest living stipend (covers basic needs)</span></div>
            <div class="term-row"><span class="term-label">Visa</span><span class="term-value">Nepal tourist visa (renewable). Support letters provided.</span></div>
            <div class="term-row"><span class="term-label">Insurance</span><span class="term-value">Required. Not provided.</span></div>
            <div class="term-row"><span class="term-label">IP</span><span class="term-value">Everything produced is open source. Belongs to the commons.</span></div>
          </div>
        </section>

        <CtaCardSection background="var(--theme-surface-1)" color="var(--theme-on-surface-1)">
          <h2>{t.jumla.applyTitle}</h2>
          <p>{t.jumla.applyText}</p>
          <div class="cta-row">
            <Button href={p('/jumla/apply', locale)} customIcon>{t.common.applyNow} <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
            <Button href={p('/community', locale)} unelevated>{t.common.contributeRemotely}</Button>
          </div>
        </CtaCardSection>

        <CtaCardSection background="var(--theme-surface-2)" color="var(--theme-on-surface-2)">
          <h2>{t.jumla.followTitle}</h2>
          <p>{t.jumla.followText}</p>
          <div class="cta-row">
            <Button href="https://github.com/FUMFGRP/mountaineerfi-remote-valley-os" customIcon>{t.common.github} <Fragment slot="icon"><Icon name="ic:baseline-launch"/></Fragment></Button>
            <Button href={p('/board', locale)} unelevated>{t.common.exploreBoard}</Button>
          </div>
        </CtaCardSection>
      </div>
      <Sidebar context="jumla" {locale} />
    </div>
  </Container>
</Layout>

<style>
  .page-hero { margin: var(--section-margin) auto; }
  .page-hero__content { max-width: 40rem; }
  .hero-ctas { display: flex; gap: 1rem; margin-top: 1.5rem; }
  .jumla-intro { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start; margin-top: 1.5rem; }
  .jumla-intro__text p { margin-bottom: 1rem; font-size: var(--font-size-sm); }
  .jumla-intro__stats { display: flex; flex-direction: column; gap: 0.75rem; }
  .jumla-stat { padding: 1rem; background-color: var(--theme-surface-1); border-radius: 0.5rem; font-size: var(--font-size-xs); }
  .jumla-stat strong { display: block; font-family: var(--theme-font-family-display); font-size: var(--font-size-lg); color: var(--accent-sunset-orange); margin-bottom: 0.25rem; }
  .findings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .finding-card { padding: 1.25rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); }
  .finding-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; gap: 0.5rem; }
  .finding-header h3 { font-size: var(--font-size-base); margin: 0; }
  .finding-priority { font-size: var(--font-size-xs); padding: 0.2rem 0.5rem; background-color: var(--accent-glacial-blue); color: var(--charcoal, #2D3436); border-radius: 1rem; font-weight: 600; white-space: nowrap; }
  .finding-card p { font-size: var(--font-size-sm); margin: 0; }
  .residency-tracks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .track-card { display: flex; gap: 1rem; padding: 1rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); align-items: flex-start; }
  .track-icon { font-size: 1.5rem; color: var(--accent-sunset-orange); flex-shrink: 0; margin-top: 0.25rem; }
  .track-info h3 { font-size: var(--font-size-sm); margin-bottom: 0.25rem; }
  .track-info p { font-size: var(--font-size-xs); margin: 0 0 0.35rem; opacity: 0.85; }
  .track-duration { display: inline-block; font-size: var(--font-size-xs); padding: 0.15rem 0.5rem; background-color: var(--theme-surface-2); border-radius: 1rem; font-weight: 600; color: var(--accent-glacial-blue); }
  .conditions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .condition-card { padding: 1.25rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); }
  .condition-card h3 { font-size: var(--font-size-sm); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; }
  .condition-card p { font-size: var(--font-size-xs); margin: 0; }
  .terms-table { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1.5rem; max-width: 36rem; }
  .term-row { display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background-color: var(--theme-surface-1); border-radius: 0.25rem; font-size: var(--font-size-sm); }
  .term-label { font-weight: 600; }
  .term-value { opacity: 0.85; text-align: right; }
  .cta-row { display: flex; gap: 1rem; justify-content: center; }
  .content-with-sidebar { display: flex; gap: 3rem; align-items: flex-start; }
  .content-main { flex: 1; min-width: 0; }
  @media (max-width: 1024px) { .content-with-sidebar { flex-direction: column; } }
  @media (max-width: 768px) { .jumla-intro { grid-template-columns: 1fr; } .findings-grid, .residency-tracks, .conditions-grid { grid-template-columns: 1fr; } .hero-ctas { flex-direction: column; } .cta-row { flex-direction: column; align-items: center; } .term-row { flex-direction: column; gap: 0.2rem; } .term-value { text-align: left; } }
</style>
