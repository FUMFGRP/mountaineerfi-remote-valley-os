---
import { SkipLink } from '@components/odyssey-theme';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import CookieConsent from '../components/CookieConsent.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import { defaultLocale, htmlLang, type Locale } from '../i18n';

export interface Props {
	seo?: BaseHeadProps;
	locale?: Locale;
}

const { seo, locale = defaultLocale } = Astro.props;
---

<html lang={htmlLang[locale]}>
	<head>
		<BaseHead {...seo} locale={locale} />
	</head>
	<body>
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
		<LanguageSuggestion {locale} />
		<CookieConsent {locale} />
	</body>
</html>
