---
import { Header, Button, Footer } from '@components/odyssey-theme';
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import settings from '../config/settings';
import { footerColumns, footerSocials } from '../config/footer';
import { nav } from '../config/nav.js';
import { defaultLocale, type Locale } from '../i18n';
import { localizePath, useTranslations } from '../i18n/utils';


export interface Props {
	seo?: BaseHeadProps;
	locale?: Locale;
}

const { seo, locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const footerLists = footerColumns.map((col) => ({
	title: t.footer[col.titleKey as keyof typeof t.footer] as string,
	items: col.items.map((item) => ({
		title: t.footer[item.key as keyof typeof t.footer] as string,
		slug: (item as { external?: boolean }).external ? item.path : localizePath(item.path, locale),
	})),
}));
---

<Layout seo={seo} locale={locale}>
	<Header rightMenu navData={nav} locale={locale} slot="header">
		<span slot="logo">
			<Logo />
		</span>
		<Button slot="action-item" href={localizePath('/board', locale)}>{t.nav.exploreBoard}</Button>
	</Header>
	<div id="page">
		{locale !== defaultLocale && (
			<aside class="translation-notice" aria-label={t.reviewNotice.label}>
				<div class="translation-notice__inner">
					<strong>{t.reviewNotice.label}:</strong> {t.reviewNotice.text}
				</div>
			</aside>
		)}
		<slot />
	</div>
	<Footer
		slot="footer"
		background="var(--theme-surface-2)"
		color="var(--theme-on-surface-2)"
		footerLists={footerLists}
    footerSocials={footerSocials}
		copyrightName={settings.name}
    showPlug={settings.showPlug}
	>
		<Logo slot="logo" />
	</Footer>
</Layout>

<style>
	.translation-notice {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0.5rem 1rem;
	}
	.translation-notice__inner {
		background-color: var(--theme-surface-1);
		border-left: 3px solid var(--accent-sunset-orange, #e17055);
		border-radius: 0.25rem;
		padding: 0.5rem 0.75rem;
		font-size: var(--font-size-xs, 0.75rem);
		line-height: 1.5;
	}
</style>
