---
import settings from '../../config/settings.js';
import { locales, defaultLocale, htmlLang, type Locale } from '../../i18n';
import { switchLocalePath } from '../../i18n/utils';

import '../../styles/index.css';

export interface Props {
	title?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
	locale?: Locale;
}

const {
	title = settings.title,
	description = settings.description,
	canonicalURL = new URL(Astro.url.pathname, Astro.site),
	image = new URL(Astro.props.image || './social.png', Astro.site),
	locale = defaultLocale,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || settings.gaMeasurementId;

// hreflang alternates for every locale, plus x-default (English)
const alternates = locales.map((l) => ({
	locale: l,
	href: new URL(switchLocalePath(Astro.url.pathname, l), Astro.site).href,
}));
const defaultHref = new URL(switchLocalePath(Astro.url.pathname, defaultLocale), Astro.site).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#2D3436" />
<!-- Google Fonts: Montserrat (Latin + Cyrillic), Caveat (display), Noto Sans Devanagari (Hindi/Nepali) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Montserrat:wght@300;400;600;700&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet" />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Language alternates -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.locale} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={defaultHref} />
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:locale" content={htmlLang[locale]} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- Organization Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Remote Valley OS by Mountaineer.fi",
  "url": "https://remotevalley.mountaineer.fi",
  "logo": "https://remotevalley.mountaineer.fi/icon-512.png",
  "description": "Open-source innovation blueprint for remote regions. 5 pillars: trash-to-filament, water purification, food production, EV logistics, mesh networks.",
  "sameAs": [
    "https://github.com/FUMFGRP/mountaineerfi-remote-valley-os",
    "https://www.youtube.com/@mountaineerFI",
    "https://instagram.com/mountaineerbjj",
    "https://www.facebook.com/mountaineerfi"
  ]
}
</script>

<!-- Google Analytics 4: defined here, loaded only after cookie consent (see CookieConsent) -->
{gaId && (
  <script define:vars={{ gaId }}>
    window.__GA_MEASUREMENT_ID = gaId;
    window.__loadGA = function () {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    };
    try {
      if (localStorage.getItem('rvo-cookie-consent') === 'granted') {
        window.__loadGA();
      }
    } catch (e) {}
  </script>
)}
