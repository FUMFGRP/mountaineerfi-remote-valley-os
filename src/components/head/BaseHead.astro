---
import settings from '../../config/settings.js';

import '../../styles/index.css';

export interface Props {
	title?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
}

const title = Astro.props.title || settings.title;
const description = Astro.props.description || settings.description;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || settings.gaMeasurementId;
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const image = new URL(Astro.props.image || './social.png', Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/png" href="/favicon.png" />
<!-- Google Fonts: Montserrat + Caveat -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet" />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- Organization Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Remote Valley OS by Mountaineer.fi",
  "url": "https://remotevalley.mountaineer.fi",
  "logo": "https://mountaineer.fi/favicon.png",
  "description": "Open-source innovation blueprint for remote regions. 5 pillars: trash-to-filament, water purification, food production, EV logistics, mesh networks.",
  "sameAs": [
    "https://youtube.com/@mountaineerfi",
    "https://instagram.com/mountaineer.fi"
  ]
}
</script>

<!-- Google Analytics 4: defined here, loaded only after cookie consent (see CookieConsent) -->
{gaId && (
  <script define:vars={{ gaId }}>
    window.__GA_MEASUREMENT_ID = gaId;
    window.__loadGA = function () {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    };
    try {
      if (localStorage.getItem('rvo-cookie-consent') === 'granted') {
        window.__loadGA();
      }
    } catch (e) {}
  </script>
)}
