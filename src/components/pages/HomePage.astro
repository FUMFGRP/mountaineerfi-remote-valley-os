---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale, type Locale } from '../../i18n';
import { localizePath, useTranslations } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const p = localizePath;

const seo = { title: t.home.seoTitle, description: t.home.seoDescription };

const pillarPaths = ['/board', '/board', '/board', '/board', '/board'];
const features = [
  { title: t.home.featureBoardTitle, text: t.home.featureBoardText, href: '/board', cta: t.common.viewBoard },
  { title: t.home.featureJumlaTitle, text: t.home.featureJumlaText, href: '/jumla', cta: t.common.applyResidency },
  { title: t.home.featureRvosTitle, text: t.home.featureRvosText, href: '/remote-valley-os', cta: t.common.viewGithub },
  { title: t.home.featureRegionsTitle, text: t.home.featureRegionsText, href: '/regions', cta: t.common.deployRegion },
];
---

<Layout {seo} {locale}>
  <section class="home-hero">
    <Container>
      <div class="home-hero__grid">
        <div class="home-hero__text">
          <p class="home-hero__label">{t.home.heroLabel}</p>
          <h1>{t.home.heroTitle}</h1>
          <p>{t.home.heroText}</p>
          <div class="home-hero__btns">
            <Button href={p('/board', locale)} customIcon>{t.common.exploreBoard} <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
            <Button href={p('/jumla', locale)} unelevated>{t.nav.jumla}</Button>
            <Button href={p('/regions', locale)} outlined>{t.common.deployRegion}</Button>
          </div>
        </div>
        <div class="home-hero__image">
          <img src="/assets/images/home/classic-hero.jpg" alt="Himalayan landscape" />
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <h2 style="text-align: center;">{t.home.pillarsTitle}</h2>
      <p style="text-align: center; max-width: 40rem; margin: 0 auto 2rem;">{t.home.pillarsText}</p>
      <div class="pillars-grid">
        {t.home.pillars.map((pillar, i) => (
          <a href={p(pillarPaths[i], locale)} class="pillar-card">
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
            <span class="pillar-cta">{t.common.learnMore} →</span>
          </a>
        ))}
      </div>
    </section>
  </Container>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <div class="feature-cards">
        {features.map((f) => (
          <a href={p(f.href, locale)} class="feature-card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <span class="pillar-cta">{f.cta} →</span>
          </a>
        ))}
      </div>
    </section>
  </Container>

  <Container>
    <section style="margin: var(--section-margin) auto;">
      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-number">5</span>
          <span class="stat-label">{t.home.statsPillars}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">∞</span>
          <span class="stat-label">{t.home.statsOpenSource}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">1</span>
          <span class="stat-label">{t.home.statsFieldLab}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">150K+</span>
          <span class="stat-label">{t.home.statsCommunity}</span>
        </div>
      </div>
    </section>
  </Container>

  <CtaCardSection background="var(--theme-surface-2)" color="var(--theme-on-surface-2)">
    <h2>{t.home.ctaTitle}</h2>
    <p>{t.home.ctaText}</p>
    <div class="cta-row">
      <Button href={p('/board', locale)} customIcon>{t.common.exploreBoard} <Fragment slot="icon"><Icon name="ic:baseline-chevron-right"/></Fragment></Button>
      <Button href={p('/jumla', locale)} unelevated>{t.nav.jumla}</Button>
      <Button href={p('/regions', locale)} outlined>{t.common.deployRegion}</Button>
    </div>
  </CtaCardSection>
</Layout>

<style>
  .home-hero { margin: var(--section-margin) auto; }
  .home-hero__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; min-height: 70vh; }
  .home-hero__label { text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--font-size-sm); color: var(--accent-glacial-blue); font-weight: 600; margin-bottom: 0.5rem; }
  .home-hero__text { max-width: 28rem; }
  .home-hero__btns { display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .home-hero__image img { width: 100%; height: 70vh; object-fit: cover; border-radius: var(--theme-shape-radius); }
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .pillar-card { display: block; padding: 1.5rem; background-color: var(--theme-surface-1); border-radius: var(--theme-shape-radius); text-decoration: none; color: inherit; transition: transform 0.2s; }
  .pillar-card:hover { transform: translateY(-3px); }
  .pillar-card h3 { margin-bottom: 0.5rem; }
  .pillar-card p { margin: 0; font-size: var(--font-size-sm); opacity: 0.85; }
  .pillar-cta { display: inline-block; margin-top: 0.75rem; font-weight: 600; font-size: var(--font-size-sm); color: var(--accent-deep-blue); }
  .feature-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .feature-card { padding: 2rem; border-radius: var(--theme-shape-radius); border: 2px solid var(--theme-surface-1); text-decoration: none; color: inherit; transition: border-color 0.2s; display: flex; flex-direction: column; }
  .feature-card:hover { border-color: var(--accent-deep-blue); }
  .feature-card p { margin: 0.5rem 0; font-size: var(--font-size-sm); opacity: 0.85; flex: 1; }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; text-align: center; }
  .stat-item { display: flex; flex-direction: column; align-items: center; }
  .stat-number { font-family: var(--theme-font-family-display); font-size: var(--font-size-xxl); color: var(--accent-sunset-orange); }
  .stat-label { font-size: var(--font-size-sm); opacity: 0.8; }
  .cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) { .home-hero__grid { grid-template-columns: 1fr; } .home-hero__image img { height: 40vh; } .pillars-grid, .feature-cards, .stats-row { grid-template-columns: 1fr; } .cta-row { flex-direction: column; align-items: center; } .home-hero__btns { flex-direction: column; } }
</style>
